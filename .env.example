# Headless Trust & Safety Pipeline - Environment Variables
# Copy this file to .env and fill in your own values

MODEL_ID=unitary/toxic-bert
TOXICITY_ALLOW_THRESHOLD=0.40
TOXICITY_REVIEW_THRESHOLD=0.80
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=trust_safety
MONGO_COLLECTION=audit_logs
MAX_TEXT_CHARS=5000
LOG_LEVEL=INFO
